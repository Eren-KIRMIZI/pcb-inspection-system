MODEL_PATH=models/pcb-solder-defect-detection-yolo26/best.pt
THRESHOLDS_PATH=models/pcb-solder-defect-detection-yolo26/thresholds.json
COMPONENT_MODEL_PATH=models/pcb-component-detection-yolo26/fine_best.pt
COMPONENT_CONF_THRESHOLD=0.20
COMPONENT_IMGSZ=1024
REFERENCE_COMPONENT_MIN_CONFIDENCE=0.45
USE_MOCK_DETECTOR=false
DEVICE=cpu
CONF_THRESHOLD=0.228
# Karar eşikleri (D7): FAIL ve manuel inceleme bantları
FAIL_MIN_CONFIDENCE=0.65
MANUAL_REVIEW_MIN_CONFIDENCE=0.40
MIN_IMAGE_WIDTH=320
MIN_IMAGE_HEIGHT=240
# SIFT/RANSAC hizalama güven eşikleri (boş bırakılırsa varsayılanlar kullanılır)
ALIGNMENT_MIN_INLIERS=8
ALIGNMENT_MIN_INLIER_RATIO=0.35
ALIGNMENT_RANSAC_THRESHOLD=5.0
ALIGNMENT_RATIO_TEST=0.75
ALIGNMENT_MIN_SCALE=0.20
ALIGNMENT_MAX_SCALE=5.0
# Komponent eşleştirme maliyet ağırlıkları (Hungarian ataması)
MATCHING_TYPE_PENALTY=3.0
MATCHING_CONFIDENCE_WEIGHT=0.4
MATCHING_AREA_WEIGHT=0.3
MATCHING_AREA_CAP=2.0
# Kusur çıkarımı / tiling (varsayılan: tam görsel, tiling kapalı)
DETECTOR_IMGSZ=640
TILING_ENABLED=false
TILE_SIZE=640
TILE_OVERLAP=0.20
TILE_NMS_IOU=0.45
# Uygulama içi değerlendirme (offline CLI: python -m backend.scripts.evaluate_model)
EVALUATION_DATASET_DIR=datasets/pcb-solder-defect-detection/final_solder
EVALUATION_OUTPUT_DIR=data/evaluation
